FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159
WORKDIR /app
COPY requirements-science.txt requirements-seismic.txt ./
RUN pip install --no-cache-dir -r requirements-seismic.txt
COPY SEISMIC_NOTICES.md /usr/share/stratax/notices/SEISMIC_NOTICES.md
COPY licenses/ /usr/share/stratax/notices/
RUN pip download --no-deps --no-binary=pylops --dest /usr/share/stratax/sources pylops==2.8.0
COPY scientific_api.py scientific_catalog.py seismic_*.py ./
COPY ingestion_core.py ingestion_native.py ./
COPY tests/test_seismic_processing.py tests/test_seismic_store.py tests/test_seismic_inversion.py tests/test_seismic_execution.py tests/test_seismic_trace_index.py tests/test_seismic_brick.py ./tests/
ARG RUN_ENGINE_TESTS=0
RUN pip install --no-cache-dir pytest==9.0.2 && if [ "$RUN_ENGINE_TESTS" = "1" ]; then python -m pytest tests -q --disable-warnings; fi
ENV PYTHONUNBUFFERED=1 OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2
CMD ["python", "seismic_batch_worker.py"]
