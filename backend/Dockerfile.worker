FROM python:3.12-slim
RUN apt-get update -qq && apt-get install -y --no-install-recommends libexpat1 libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-worker.txt .
RUN pip install --no-cache-dir -r requirements-worker.txt
COPY ingestion_core.py ingestion_native.py ingestion_worker.py native_selftest.py ./
COPY test-fixtures/ ./test-fixtures/
RUN python native_selftest.py
ENV PYTHONUNBUFFERED=1
CMD ["python", "ingestion_worker.py"]
